{
  "Urls": "http://localhost:5004",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=saar_banking_expressions;Username=apple;Password=;Port=5432;",
    "ExpressionBuilderDatabase": "Host=localhost;Database=saar_banking_expressions;Username=apple;Password=;Port=5432;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",
  "ExpressionBuilderSettings": {
    "MaxExecutionTimeMs": 5000,
    "MaxExpressionLength": 10000,
    "EnableSecurityValidation": true,
    "AllowedAssemblies": [
      "System.Runtime",
      "System.Linq",
      "System.Math",
      "System.DateTime"
    ],
    "BlockedTypes": [
      "System.IO",
      "System.Net",
      "System.Diagnostics",
      "System.Reflection"
    ]
  },
  "GeminiAI": {
  "ApiKey": "",
    "Model": "gemini-1.5-flash",
    "BaseUrl": "https://generativelanguage.googleapis.com",
    "MaxTokens": 1000,
    "Temperature": 0.7,
    "TopP": 0.9,
    "TopK": 40
  },
  "GptOssAI": {
    "BaseUrl": "http://localhost:8080/v1", 
    "Model": "gpt-oss", 
    "ApiKey": "", 
    "MaxTokens": 512, 
    "Temperature": 0.7,
    "RequestTimeoutSeconds": 120
  },
  "OllamaAI": {
    "BaseUrl": "http://localhost:11434",
  "Model": "llama3.2",
    "Temperature": 0.7,
    "MaxTokens": 512,
    "RequestTimeoutSeconds": 120
  },
  "OpenAI": {
    "BaseUrl": "https://api.openai.com/v1",
    "Model": "gpt-5-nano",
    "ApiKey": "",
    "MaxTokens": 256,
    "Temperature": 0.2,
    "RequestTimeoutSeconds": 45
  },
  "LlmSettings": {
  "DefaultProvider": "ollama"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/expressionbuilder-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  }
}
