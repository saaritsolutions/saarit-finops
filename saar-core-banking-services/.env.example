# ──────────────────────────────────────────────────────────────────────────────
# SaaR Core Banking — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=saar_demo_2026

# OpenAI API key (required for AI expression/form generation)
OPENAI_API_KEY=sk-...

# CORS: domain(s) that the React frontend is served from (semicolon-separated for multiple)
CORS_ALLOWED_ORIGINS=https://demobank.saaritsolutions.com

# Domain (used in nginx.conf and certbot)
DOMAIN=demobank.saaritsolutions.com
