  "scripts": {
    "start": "PORT=3002 BROWSER=none REACT_APP_VERSION=$npm_package_version REACT_APP_BUILD_TIME=$(date +%s) craco start",
    "build": "REACT_APP_VERSION=$npm_package_version REACT_APP_BUILD_TIME=$(date +%s) craco build",
    "test": "craco test",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:workflow-config": "node scripts/test-workflow-config.mjs",
    "eject": "react-scripts eject",
    "version-bump": "npm version patch --no-git-tag-version && echo \"Version updated to $(node -p \"require(\\\"./package.json\\\").version\")\"",
    "version-patch": "node scripts/update-version.js patch",
    "version-minor": "node scripts/update-version.js minor",
    "version-major": "node scripts/update-version.js major"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@tanstack/react-query-devtools": "^5.83.0",
    "@testing-library/cypress": "^10.0.2",
