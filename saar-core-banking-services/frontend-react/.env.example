# Frontend multi-service configuration
# All three vars point to the SAME domain when deployed via nginx reverse proxy.
# For local dev, point each to the individual service port.

# ExpressionBuilderService base URL (AI Form APIs via apiService.ts)
REACT_APP_API_BASE_URL=http://localhost:5004

# LoanService base URL (Origination APIs)
REACT_APP_LOAN_SERVICE_BASE_URL=http://localhost:5130

# ExpressionBuilderService base URL (Expression CRUD via apiClient.ts)
REACT_APP_EXPRESSION_API_URL=http://localhost:5004
